# Copy to .env on Hostinger (SSH / File Manager). Never commit real secrets.
# Generate APP_KEY locally: php artisan key:generate --show

APP_NAME="Adham Mansour"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.hostingersite.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Option A — SQLite (simplest for portfolio; no hPanel DB step)
DB_CONNECTION=sqlite
# Ensure database/database.sqlite exists and is writable (deploy script creates it)

# Option B — MySQL (hPanel → Databases)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u358087675_portfolio
# DB_USERNAME=u358087675_portfolio
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="adhammansour500@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
